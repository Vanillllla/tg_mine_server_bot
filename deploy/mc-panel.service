[Unit]
Description=Minecraft Web Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mc-panel
Group=mc-panel
WorkingDirectory=/opt/mc-server-controller
Environment=MC_PANEL_HOME=/srv/mc-panel
Environment=MC_PANEL_VERSION=0.1.1
Environment=MC_PANEL_GITHUB_REPO=Vanillllla/mc-server-controller
Environment=MC_PANEL_ADMIN_USERNAME=admin
Environment=MC_PANEL_ADMIN_PASSWORD=change-me
Environment=MC_PANEL_UPDATE_SCRIPT=/usr/local/sbin/mc-panel-update
ExecStart=/opt/mc-server-controller/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/mc-panel /opt/mc-server-controller /opt/mc-server-controller-backups

[Install]
WantedBy=multi-user.target
